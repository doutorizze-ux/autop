{
  "name": "centro-automotivo-0058",
  "version": "1.0.0",
  "description": "Centro Automotivo 0058 - Gestão & Cotações",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.centroautomotivo0058.app",
    "productName": "Centro Automotivo 0058",
    "directories": {
      "output": "dist-installer"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/prisma/**/*",
      "backend/data/**/*",
      "backend/node_modules/**/*",
      "backend/.env",
      "scraping/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Centro Automotivo 0058",
      "include": "build/installer.nsh"
    }
  }
}